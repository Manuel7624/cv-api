# Copia este archivo como .env y escribe tus claves. El archivo .env nunca se sube a Git.
GROQ_API_KEY=
GEMINI_API_KEY=

# Token de la página privada de estadísticas (/admin/stats), de al menos 20
# caracteres. Sin valor, la página no existe. Para generar uno:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Límites del chat. Si se dejan vacíos, se usan estos mismos valores.
CHAT_MESSAGES_PER_MINUTE_PER_IP=5
CHAT_MESSAGES_PER_DAY_PER_IP=30
CHAT_MESSAGES_PER_DAY_TOTAL=300
CHAT_MAX_MESSAGE_LENGTH=500
